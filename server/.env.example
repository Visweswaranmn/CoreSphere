# ─── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Comma-separated list of allowed browser origins (the web client).
CORS_ORIGINS=http://localhost:5173

# ─── Database ──────────────────────────────────────────────────────────────
# MongoDB Atlas connection string. Create a free cluster at
# https://www.mongodb.com/cloud/atlas and paste the SRV string below.
# Example: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/coresphere_erp
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/coresphere_erp?retryWrites=true&w=majority

# ─── Auth (used from Phase 2 onward) ────────────────────────────────────────
# JWT_ACCESS_SECRET=change-me
# JWT_REFRESH_SECRET=change-me
