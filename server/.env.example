# ─── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Comma-separated list of allowed browser origins (the web client).
CORS_ORIGINS=http://localhost:5173

# ─── Database ──────────────────────────────────────────────────────────────
# MongoDB Atlas connection string. Create a free cluster at
# https://www.mongodb.com/cloud/atlas and paste the SRV string below.
# Example: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/coresphere_erp
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/coresphere_erp?retryWrites=true&w=majority

# ─── Auth ───────────────────────────────────────────────────────────────────
# Generate strong secrets, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# In production these MUST be set to unique values of at least 32 characters.
JWT_ACCESS_SECRET=dev-insecure-change-me
JWT_REFRESH_SECRET=dev-insecure-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_DAYS=7

# Set to true when the web app and API are hosted on different sites
# (e.g. web on Vercel, API on Render) so the refresh cookie is sent cross-site.
CROSS_SITE_COOKIES=false

# ─── Seeding (optional) ──────────────────────────────────────────────────────
# SEED_ADMIN_EMAIL=admin@coresphere.local
# SEED_ADMIN_PASSWORD=Admin@12345
